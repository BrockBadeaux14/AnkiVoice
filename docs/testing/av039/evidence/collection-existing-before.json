  "notes": [
    {
      "id": 1789515446831,
      "notetype": "VoiceQA",
      "tags": "av002 fixture::new profile::baseline state::new",
      "fields": [
        "A box has three red blocks and two blue blocks. How many blocks are there in total?",
        "Five blocks.",
        "Five",
        "Five\n5\nThere are five blocks",
        "en-US",
        "Three plus two equals five."
      ]
    },
    {
      "id": 1789515446832,
      "notetype": "VoiceQA",
      "tags": "av002 fixture::learning profile::baseline state::learning",
      "fields": [
        "Reverse the sequence red, blue, green.",
        "Green, blue, red.",
        "Green first\nBlue second\nRed last",
        "Green blue red",
        "en-US",
        "Reversing changes the order, not the items."
      ]
    },
    {
      "id": 1789515446833,
      "notetype": "VoiceQA",
      "tags": "av002 fixture::relearning profile::baseline state::relearning",
      "fields": [
        "In a game, a token is valid only if it is blue and square. A token is blue and round. Is it valid, and why?",
        "No. It is blue but not square, and both conditions are required.",
        "It is not valid\nIt fails the square requirement",
        "No, because it is round instead of square.",
        "en-US",
        "Meeting just one required condition is insufficient."
      ]
    },
    {
      "id": 1789515446834,
      "notetype": "VoiceQA",
      "tags": "av002 fixture::mature profile::baseline state::mature",
      "fields": [
        "A machine sorts numbers from smallest to largest. Explain what it does to the list seven, two, five.",
        "It returns two, five, seven, ordering the numbers from smallest to largest.",
        "The resulting order is two, five, seven",
        "Two five seven",
        "en-US",
        "The values stay the same; only their order changes."
      ]
    },
