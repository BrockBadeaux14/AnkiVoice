<?xml version="1.0" encoding="utf-8"?>
<!--
  AGP rewrites the first instrumentation entry to the defaultConfig runner. Keep AV-024's
  default runner first, then the additional live entry points, so packaging preserves
  every component selected explicitly by `am instrument`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <instrumentation
        android:name="org.ankivoice.app.ReviewInstrumentation"
        android:targetPackage="org.ankivoice" />

    <instrumentation
        android:name="org.ankivoice.app.SpeechInstrumentation"
        android:targetPackage="org.ankivoice" />

    <instrumentation
        android:name="org.ankivoice.app.SessionInstrumentation"
        android:targetPackage="org.ankivoice" />

    <instrumentation
        android:name="org.ankivoice.app.JournalInstrumentation"
        android:targetPackage="org.ankivoice" />

    <instrumentation
        android:name="org.ankivoice.app.CommandInstrumentation"
        android:targetPackage="org.ankivoice" />

    <instrumentation
        android:name="org.ankivoice.app.EvaluationInstrumentation"
        android:targetPackage="org.ankivoice" />

    <instrumentation
        android:name="org.ankivoice.app.ConfidenceInstrumentation"
        android:targetPackage="org.ankivoice" />

    <instrumentation
        android:name="org.ankivoice.app.ExchangeInstrumentation"
        android:targetPackage="org.ankivoice" />

    <instrumentation
        android:name="org.ankivoice.app.StudyInstrumentation"
        android:targetPackage="org.ankivoice" />
</manifest>
